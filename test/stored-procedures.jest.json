{
  "rootDir": "..",
  "testEnvironment": "node",
  "testMatch": [
    "<rootDir>/test/stored-procedures.spec.ts",
    "<rootDir>/src/**/*.spec.ts"
  ],
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1",
    "^shared/(.*)$": "<rootDir>/shared/$1"
  },
  "transform": {
    "^.+\\.ts$": "ts-jest"
  }
}
